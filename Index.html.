<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Kamba Market - Compra e Venda</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f4f4;
  color: #222;
}

header {
  background: #087f3e;
  color: white;
  padding: 18px;
  text-align: center;
}

header h1 {
  margin: 0;
  font-size: 30px;
}

header p {
  margin: 7px 0 0;
}

.search-box {
  background: white;
  padding: 15px;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2px 5px #ccc;
}

.search-box input {
  width: 100%;
  padding: 14px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 16px;
}

.categories {
  display: flex;
  gap: 8px;
  padding: 12px;
  overflow-x: auto;
  background: white;
}

.categories button {
  border: none;
  background: #087f3e;
  color: white;
  padding: 10px 15px;
  border-radius: 20px;
  white-space: nowrap;
  cursor: pointer;
}

.categories button:hover {
  background: #055c2d;
}

.container {
  max-width: 1100px;
  margin: auto;
  padding: 15px;
}

.title {
  margin-top: 10px;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.product {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px #ccc;
}

.product-image {
  height: 170px;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 55px;
}

.product-content {
  padding: 15px;
}

.product h3 {
  margin: 0 0 8px;
}

.price {
  color: #087f3e;
  font-weight: bold;
  font-size: 19px;
}

.category {
  color: #777;
  font-size: 13px;
}

.location {
  color: #555;
  font-size: 14px;
  margin: 8px 0;
}

.contact {
  display: block;
  text-align: center;
  background: #087f3e;
  color: white;
  padding: 11px;
  border-radius: 7px;
  text-decoration: none;
  margin-top: 10px;
}

.contact:hover {
  background: #055c2d;
}

.no-results {
  text-align: center;
  padding: 40px;
  display: none;
}

.sell {
  margin-top: 30px;
  background: white;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 8px #ccc;
}

.sell input,
.sell select,
.sell textarea {
  width: 100%;
  padding: 12px;
  margin: 7px 0;
  border: 1px solid #ccc;
  border-radius: 7px;
}

.sell button {
  width: 100%;
  padding: 13px;
  border: none;
  border-radius: 7px;
  background: #087f3e;
  color: white;
  font-size: 16px;
}

footer {
  background: #222;
  color: white;
  text-align: center;
  padding: 25px;
  margin-top: 35px;
}
</style>
</head>

<body>

