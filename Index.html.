<div class="sell">

<h2>📢 Anunciar produto</h2>

<p>Queres vender alguma coisa? Preenche os dados abaixo.</p>

<input type="text" id="nomeProduto" placeholder="Nome do produto">

<select id="categoriaProduto">
  <option>Carros</option>
  <option>Ouro</option>
  <option>Animais</option>
  <option>Telefones</option>
  <option>Eletrónicos</option>
  <option>Roupas</option>
  <option>Casas</option>
  <option>Terrenos</option>
  <option>Diversos</option>
</select>

<input type="text" id="precoProduto" placeholder="Preço em Kz">

<input type="text" id="localProduto" placeholder="Localização">

